@model IEnumerable<QuanLyQuanCaPhe23.Models.CaPhe>

@{
    ViewData["Title"] = "Danh sách cà phê";
    Layout = "_NewLayout";
}
<title>@ViewData["Title"]</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="~/css/card.css">
<div class="container coffee-list-container">
    <h1 class="text-center mb-5">Danh sách cà phê</h1>
    <div class="search-container mb-5">
        <form asp-action="ListCaPhe" method="get">
            <div class="search-wrapper">
                <div class="search-box">
                    <input type="text" id="filter1" name="kw" class="search-input" placeholder="Tìm theo tên" value="@ViewData["FilterKw"]" />
                    <i class="fas fa-search search-icon"></i>
                </div>
                <div class="filter-box">
                    <select id="filter2" name="size" class="filter-select">
                        <option value="">Chọn size</option>
                        <option value="1">Nhỏ</option>
                        <option value="2">Vừa</option>
                        <option value="3">Lớn</option>
                        <option value="4">Nóng</option>
                    </select>
                    <i class="fas fa-chevron-down select-icon"></i>
                </div>
                <div class="price-box">
                    <input type="number" id="filter3" name="gia" class="price-input" placeholder="Giá tối đa" value="@ViewData["FilterGia"]" />
                    <i class="fas fa-dollar-sign price-icon"></i>
                </div>
                <button type="submit" class="search-btn">
                    <i class="fas fa-filter"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    @if (ViewData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center" role="alert">
            @ViewData["SuccessMessage"]
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4">
                <div class="card h-100 coffee-card">
                    <img src="@item.Anh" class="card-img-top" alt="@item.Ten" />
                    <div class="card-body">
                        <h5 class="card-title">@item.Ten</h5>
                        <p class="card-text">@item.MieuTa</p>
                        <p class="card-text"><small class="text-muted">Size: @item.Size.Ten</small></p>
                        <p class="card-text">
                            <strong>Giá: @(item.Tien.HasValue ? item.Tien.Value.ToString("#,##0 VNĐ") : "N/A")</strong>
                        </p>
                    </div>
                    <div class="card-footer text-center">
                        @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "GioHang", new { id = item.Id }, new { @class = "btn btn-success btn-sm m-1" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm m-1" })
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" href="/NguoiDung/ListCaPhe?page=@i&kw=@ViewData["FilterKw"]&size=@ViewData["FilterSize"]&gia=@ViewData["FilterGia"]">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
<button id="back_to_top"><i class="fa-solid fa-angles-up"></i></button>
<script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var selectedSize = "@ViewData["FilterSize"]";
        var selectElement = document.getElementById("filter2");
        if (selectedSize) {
            selectElement.value = selectedSize;
        }

        var selectedGia = "@ViewData["FilterGia"]";
        var priceElement = document.getElementById("filter3");
        if (selectedGia) {
            priceElement.value = selectedGia;
        }
    });

            /*Back to top button*/
            const backToTopbtn = document.querySelector("#back_to_top");
    window.addEventListener("scroll", scrollFunction);

    function scrollFunction() {
        if (window.pageYOffset > 1000) {  //show backtotop
            if (!backToTopbtn.classList.contains("button_entrance")) {
                backToTopbtn.classList.remove("button_exit");
                backToTopbtn.classList.add("button_entrance");

                backToTopbtn.style.display = "block";
            }
        }
        else { //hidden backtotop
            if (backToTopbtn.classList.contains("button_entrance")) {
                backToTopbtn.classList.remove("button_entrance");
                backToTopbtn.classList.add("button_exit");
                setTimeout(function () {
                    backToTopbtn.style.display = "none";
                }, 200);
            }
        }
        backToTopbtn.addEventListener("click", backtotop);

        function backtotop() {
            window.scrollTo(0, 0);
        }
    }
</script>
<df-messenger intent="WELCOME"
              chat-title="CoffeeChatBot"
              agent-id="42d11d89-b9c8-440b-b546-e581580578cf"
              language-code="vi"></df-messenger>

<style>
    body {
        margin-top: 75px;
    }
    /* slide show auto */
        .slick-dots li button:before {
            font-size: 13px;
        }
        .slider {
            width: 100%;
            margin: 20px auto;
        }

        .slick-slide img {
            width: 100%;
        }

        .slick-arrows {
            position: absolute;
            width: 40px;
            height: 50px;
            border-radius: 4px;
            border: none;
            background: rgba(0, 0, 0, 0.6);
            color: #fff;
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
        }

            .slick-arrows:hover {
                background: rgba(255, 255, 255, 0.6);
                color: #000;
            }

        .slick-prev {
            left: 0;
        }

        .slick-next {
            right: 0;
        }

        .slick-dots {
            position: absolute;
            list-style: none;
            display: flex !important;
            z-index: 2;
            left: 93%;
            transform: translateX(-50%);
            bottom: -30px;
        }

            .slick-dots button {
                background-color: rgb(207, 204, 204);
                font-size: 13px;
                border-radius: 50%;
                border: none;
                outline: none;
                width: 15px;
                margin: 0px;
                height: 15px;
            }

                .slick-dots .slick-active button,
                .slick-dots button:hover {
                    background: #0a5e98;
                }
    .coffee-list-container {
        background-color: #f8f9fa;
        padding: 3rem 0;
        font-family: 'Poppins', sans-serif;
    }

    .search-container {
        max-width: 100%;
        margin: 0 auto;
    }

    .search-wrapper {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        background-color: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .search-box, .filter-box, .price-box {
        position: relative;
        margin-bottom: 10px;
        flex: 1 1 200px;
        margin-right: 10px;
    }

    .search-input, .filter-select, .price-input {
        width: 100%;
        padding: 12px 40px 12px 15px;
        border: 1px solid #ddd;
        border-radius: 25px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .search-input:focus, .filter-select:focus, .price-input:focus {
        outline: none;
        border-color: #6f4e37;
        box-shadow: 0 0 0 2px rgba(111, 78, 55, 0.2);
    }

    .search-icon, .select-icon, .price-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6f4e37;
    }

    .filter-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        cursor: pointer;
    }

    .search-btn {
        background-color: #6f4e37;
        color: #fff;
        border: none;
        padding: 12px 25px;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 500;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .search-btn:hover {
        background-color: #5a3d2b;
        transform: translateY(-2px);
        box-shadow: 0 5px 10px rgba(0,0,0,0.2);
    }

    .coffee-card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .coffee-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .coffee-card .card-img-top {
        height: 200px;
        object-fit: cover;
    }

    .coffee-card .card-body {
        background-color: #fff;
    }

    .coffee-card .card-footer {
        background-color: #fff;
        border-top: 1px solid rgba(0,0,0,.125);
    }

    .btn-primary {
        background-color: #6f4e37;
        border-color: #6f4e37;
    }

    .btn-primary:hover {
        background-color: #5a3d2b;
        border-color: #5a3d2b;
    }

    .pagination .page-link {
        color: #6f4e37;
    }

    .pagination .page-item.active .page-link {
        background-color: #6f4e37;
        border-color: #6f4e37;
    }

    h1 {
        color: #6f4e37;
        font-weight: bold;
    }

    df-messenger {
        --df-messenger-bot-message: #6f4e37;
        --df-messenger-button-titlebar-color: #6f4e37;
        --df-messenger-chat-background-color: #fafafa;
        --df-messenger-font-color: white;
        --df-messenger-send-icon: #6f4e37;
        --df-messenger-user-message: #5a3d2b;
    }

    back_to_top {
        position: fixed;
        bottom: 20px;
        right: 40px;
        font-size: 18px;
        width: 40px;
        height: 40px;
        color: #fff;
        background-color: #0a5e98;
        border: none;
        cursor: pointer;
        border-radius: 50%;
        outline: none;
        transition-duration: 0.2s;
        transition-timing-function: ease-in-out;
        transition-property: backround-color, color;
    }

    #back_to_top:hover,
    #back_to_top:focus {
        background-color: #71afd5;
        color: white;
    }

    .button_entrance {
        animation-duration: 0.5s;
        animation-fill-mode: both;
        animation-name: button_entrance;
    }
</style>
