@model QuanLyQuanCaPhe23.Models.KhachHang

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_NewLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Đăng ký </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/colorful-login.css" />
    <style>
        body {
            margin-top: 75px;
            padding: 0;
            font-family: 'Arial', sans-serif;
        }

        .colorful-bg {
            background: linear-gradient(45deg, #FF9A8B, #FF6B95, #FF8E53, #FFA647, #FFD700);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }

        .login-card {
            background-color: rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            border: 5px solid #FFD700;
            margin: 50px 0;
            max-width: 1000px;
        }

        .login-body {
            padding: 30px;
        }

        .login-title {
            color: #FF6B95;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            border: none;
            border-bottom: 3px solid #FF8E53;
            border-radius: 0;
            padding: 10px 5px;
            background-color: transparent;
            transition: all 0.3s ease;
            color: #333;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #FF6B95;
            }

        .control-label {
            color: #FF6B95;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .btn-primary {
            background: linear-gradient(45deg, #FF6B95, #FF8E53);
            border: none;
            border-radius: 30px;
            padding: 12px 30px;
            font-size: 1.2rem;
            font-weight: 600;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin: 0 auto;
            width: 50%;
        }

            .btn-primary:hover {
                background: linear-gradient(45deg, #FF8E53, #FF6B95);
                transform: translateY(-3px);
                box-shadow: 0 7px 20px rgba(255, 107, 149, 0.4);
            }

        .back-to-home {
            display: block;
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #FF6B95;
            text-decoration: none;
            margin-top: 20px;
            transition: color 0.3s ease, text-decoration 0.3s ease;
        }

            .back-to-home:hover {
                color: #FF8E53;
                text-decoration: underline;
            }

        .text-danger {
            font-size: 0.9rem;
            margin-top: 5px;
            color: #FF6B95;
        }

        .alert {
            border-radius: 10px;
            margin-top: 20px;
            background-color: #FFD700;
            color: #333;
            border: none;
            padding: 10px;
            text-align: center;
        }

        .coffee-image-container {
            position: relative;
            overflow: hidden;
        }

        .coffee-image {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
        }

            .coffee-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        df-messenger {
            --df-messenger-bot-message: #FF6B95;
            --df-messenger-button-titlebar-color: #FF8E53;
            --df-messenger-chat-background-color: #FFF5E6;
            --df-messenger-font-color: white;
            --df-messenger-send-icon: #FF6B95;
            --df-messenger-user-message: #FF8E53;
        }
    </style>
</head>
<body class="colorful-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="login-card">
                    <div class="row no-gutters">
                        <div class="col-md-7">
                            <div class="login-body">
                                <h1 class="login-title">Đăng ký khách hàng</h1>
                                <span class="text-danger">@ViewData["ErrorMessage"]</span>
                                <form asp-action="DangKy">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="HoKh" class="control-label">Họ của bạn</label>
                                                <input asp-for="HoKh" placeholder="Nhập họ..." class="form-control" />
                                                <span asp-validation-for="HoKh" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loil"]</span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="TenKh" class="control-label">Tên của bạn</label>
                                                <input asp-for="TenKh" placeholder="Nhập tên..." class="form-control" />
                                                <span asp-validation-for="TenKh" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi2"]</span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="UserName" class="control-label">Tên đăng nhập</label>
                                                <input asp-for="UserName" placeholder="Nhập tên đăng nhập..." class="form-control" />
                                                <span asp-validation-for="UserName" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi3"]</span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="Pass" class="control-label">Mật khẩu</label>
                                                <input asp-for="Pass" type="password" placeholder="Nhập mật khẩu..." class="form-control" />
                                                <span asp-validation-for="Pass" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi4"]</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label asp-for="DiaChi" class="control-label">Địa chỉ</label>
                                                <input asp-for="DiaChi" placeholder="Nhập địa chỉ..." class="form-control" />
                                                <span asp-validation-for="DiaChi" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi5"]</span>
                                            </div>
                                            <div class="form-group">
                                                <label asp-for="SoDienThoai" class="control-label">Số điện thoại</label>
                                                <input asp-for="SoDienThoai" type="text"
                                                       placeholder="Nhập số điện thoại..."
                                                       class="form-control"
                                                       pattern="[0-9]{10}"
                                                       title="Số điện thoại phải là 10 chữ số" />
                                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi6"]</span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Gmail" class="control-label">Gmail</label>
                                                <input asp-for="Gmail" type="email" placeholder="Nhập vào gmail" class="form-control" />
                                                <span asp-validation-for="Gmail" class="text-danger"></span>
                                                <span class="text-danger">@ViewData["Loi7"]</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group text-center">
                                        <input type="submit" value="Đăng ký" class="btn btn-primary" />
                                    </div>
                                    <div class="form-group text-center mt-3">
                                        <a href="@Url.Action("TrangChu", "Home")" class="back-to-home">Trở về trang chủ</a>
                                    </div>
                                    @if (ViewData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success" role="alert">
                                            @ViewData["SuccessMessage"]
                                        </div>
                                    }
                                </form>
                            </div>
                        </div>
                        <div class="col-md-5 coffee-image-container">
                            <div class="coffee-image">
                                <img src="~/images/hinhdai.jpg" alt="Coffee Image" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger intent="WELCOME"
                  chat-title="CoffeeChatBot"
                  agent-id="42d11d89-b9c8-440b-b546-e581580578cf"
                  language-code="vi"></df-messenger>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>