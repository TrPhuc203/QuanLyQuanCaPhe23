@model QuanLyQuanCaPhe23.Models.CaPhe

@{
    ViewData["Title"] = "Xóa cà phê";
}
<title>@ViewData["Title"]</title>
<div class="container mt-5">
    <h1 class="text-center mb-4">XÓA SẢN PHẨM CÀ PHÊ</h1>

    <div class="card mb-4 shadow-lg">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Xác nhận xóa sản phẩm</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center">
                    <img src="@Html.DisplayFor(model => model.Anh)" class="img-fluid rounded shadow-sm mb-3" alt="@Model.Ten" style="max-height: 200px;" />
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-4">Tên cà phê</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Ten)</dd>

                        <dt class="col-sm-4">Miêu tả</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MieuTa)</dd>

                        <dt class="col-sm-4">Size</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Size.Ten)</dd>

                        <dt class="col-sm-4">Giá tiền</dt>
                        <dd class="col-sm-8">@string.Format("{0:N0} VNĐ", Model.Tien)</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-center">
                <form asp-action="Delete" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-lg mr-2">
                        <i class="fas fa-trash-alt mr-2"></i>Xác nhận xóa
                    </button>
                </form>
                <a asp-action="ListCaPhe" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left mr-2"></i>Trở về danh sách
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        margin-top: 75px;
        background-color: #f8f9fa;
        color: #343a40;
        font-family: 'Roboto', sans-serif;
    }

    .container {
        max-width: 1120px;
    }

    .card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        background-color: #dc3545;
        padding: 1.5rem;
    }

    .card-body {
        padding: 2rem;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

    dt {
        font-weight: bold;
        color: #495057;
    }

    dd {
        margin-bottom: 0.5rem;
    }

    .shadow-lg {
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }

    .shadow-sm {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    h1 {
        color: #343a40;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .btn {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>